# DiabetesRx Tracker — environment variables
# Copy this file to .env and fill in values as needed.
# For local static development, no variables are required — just run: npm run dev

# Port for local development (default: 3001)
# PORT=3001

# Only needed if you run the Express server (npm run start:server)
# DATABASE_URL=postgresql://user:password@localhost:5432/diabetesrx
